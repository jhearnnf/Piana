{
  "name": "piana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cute, minimal Synthesia-style piano trainer for the desktop.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "node tools/dev.cjs",
    "icon": "electron tools/make-icon.cjs",
    "exe": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-exe.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-shortcut.ps1",
    "mac": "sh tools/make-app.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "playwright": "^1.61.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
